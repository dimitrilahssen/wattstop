# Supabase (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL publique de l'app : encodée dans les QR codes imprimés (https obligatoire en prod)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Style de carte MapLibre (optionnel). Défaut : OpenFreeMap positron (clair), gratuit et sans clé.
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Tests de bout en bout (npm run test:e2e) : deux comptes dédiés, jamais de vrais utilisateurs.
# Créez-les dans Supabase > Authentication > Users > Add user, en cochant « Auto Confirm User ».
# E2E_HOST_EMAIL=vous+hote@gmail.com
# E2E_DRIVER_EMAIL=vous+conducteur@gmail.com
# E2E_PASSWORD=un-mot-de-passe-de-test
# E2E_BASE_URL=http://localhost:3000
# E2E_CHARGE_SECONDS=70
